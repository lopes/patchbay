# Copy this file to `.env` and fill in your value.
# `.env` is git-ignored and must never be committed.

# Spotify's "API key" is your app's Client ID from the Developer Dashboard
# (https://developer.spotify.com/dashboard). This is the only credential
# patchbay needs — the PKCE auth flow means there is NO client secret.
SPOTIFY_CLIENT_ID=your_client_id_here

# Must match a Redirect URI registered on your Spotify app exactly.
# Use the loopback IP 127.0.0.1, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. Where the access/refresh tokens are cached after you authorize.
# Defaults to ~/.config/patchbay/token.json, falling back to ~/.patchbay/token.json
# (created with 0600 permissions).
# SPOTIFY_TOKEN_PATH=/absolute/path/to/token.json

# Optional. Only if you ever switch from PKCE to the classic Authorization
# Code flow. Not used by default and not required.
# SPOTIFY_CLIENT_SECRET=your_client_secret_here
